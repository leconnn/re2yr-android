Red Alert/

# Python bytecode caches
__pycache__/
*.pyc

# Android / build outputs (the personal bundled APK contains game files; never commit it)
local.properties
.gradle/
build/
.cxx/
.kotlin/
*.apk
*.aab

# Documentation, reports, plans and notes are private: keep them local, never commit.
# Only README.md is public.
*.md
!/README.md

# Reverse-engineering scripts and material are private.
# Only the data tables the engine build reads are public.
/re/*
!/re/data/
/re/data/*
